# Puerto en el que corre el servidor Express
PORT=4000

# Cadena de conexión de tu cluster de MongoDB Atlas.
# Se obtiene desde Atlas → Database → Connect → Drivers → Node.js.
# IMPORTANTE: reemplazá <usuario>, <password> y <nombre-db> por los tuyos,
# y nunca subas el archivo .env real (con las credenciales) al repositorio.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<nombre-db>?retryWrites=true&w=majority
