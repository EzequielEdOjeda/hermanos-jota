# Puerto donde corre la API (Render define PORT automáticamente)
PORT=4000

# Conexión a MongoDB.
#   Local:  mongodb://127.0.0.1:27017/hermanosjota
#   Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/hermanosjota?retryWrites=true&w=majority
# Si la contraseña tiene caracteres especiales (@ : / ? # %) hay que codificarlos.
MONGODB_URI=mongodb://127.0.0.1:27017/hermanosjota

# Secreto con el que se firman los JWT. Usá un string largo y aleatorio. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-string-largo
JWT_EXPIRES=7d

# (Opcional) Admin propio para `npm run seed:users`. Si no los definís se usan
# admin@hermanosjota.com / admin123. Recomendado cuando la base está en internet.
# SEED_ADMIN_EMAIL=tu-admin@ejemplo.com
# SEED_ADMIN_PASSWORD=una-contraseña-segura
